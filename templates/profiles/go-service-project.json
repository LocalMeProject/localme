{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "example-go-service",
  "projectType": "application",
  "sourceRoot": "services/example-go-service",
  "tags": [
    "profile:a",
    "scope:backend",
    "lang:go"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "golangci-lint run ./...",
        "cwd": "services/example-go-service"
      },
      "inputs": ["default"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test -v -race -covermode=atomic -coverprofile=coverage.out ./...",
        "cwd": "services/example-go-service"
      },
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/coverage.out"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "CGO_ENABLED=0 go build -ldflags=\"-s -w\" -o dist/server ./cmd/server",
        "cwd": "services/example-go-service"
      },
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "govulncheck ./...",
        "cwd": "services/example-go-service"
      },
      "inputs": ["default"]
    }
  }
}
