{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "example-rust-service",
  "projectType": "application",
  "sourceRoot": "services/example-rust-service",
  "tags": [
    "profile:a",
    "scope:backend",
    "lang:rust"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --all-targets -- -D warnings",
        "cwd": "services/example-rust-service"
      },
      "inputs": ["default"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --all-targets -- --nocapture",
        "cwd": "services/example-rust-service"
      },
      "inputs": ["default", "^production"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build --release",
        "cwd": "services/example-rust-service"
      },
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/target/release"]
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo audit",
        "cwd": "services/example-rust-service"
      },
      "inputs": ["default"]
    }
  }
}
