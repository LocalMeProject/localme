{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "example-mobile-app",
  "projectType": "application",
  "sourceRoot": "apps/example-mobile-app/lib",
  "tags": [
    "profile:c",
    "scope:mobile",
    "lang:dart"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flutter analyze --fatal-infos --fatal-warnings",
        "cwd": "apps/example-mobile-app"
      },
      "inputs": ["default"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flutter test --coverage",
        "cwd": "apps/example-mobile-app"
      },
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/coverage"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flutter build apk --release",
        "cwd": "apps/example-mobile-app"
      },
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/build/app/outputs/flutter-apk"]
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dart pub outdated",
        "cwd": "apps/example-mobile-app"
      },
      "inputs": ["default"]
    }
  }
}
