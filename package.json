{
  "name": "localme",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Backend-as-a-Service (BaaS) and Edge Platform-as-a-Service (PaaS) - Pure .NET 10 Stack",
  "repository": {
    "type": "git",
    "url": "https://github.com/LocalMeProject/localme.git"
  },
  "scripts": {
    "dev": "dotnet run --project apps/server/src/LocalMe.Server.csproj",
    "start": "dotnet run --project apps/server/src/LocalMe.Server.csproj --configuration Release",
    "nx": "nx",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "audit": "nx run-many -t audit",
    "deploy:runflare": "bash scripts/deploy-runflare.sh",
    "gates": "python3 scripts/verify-nx-targets.py && python3 scripts/verify-agent-manifests.py && python3 scripts/check-nc-items.py",
    "gates:targets": "python3 scripts/verify-nx-targets.py",
    "gates:agents": "python3 scripts/verify-agent-manifests.py",
    "gates:nc": "python3 scripts/check-nc-items.py",
    "gates:change-surface": "python3 scripts/validate-change-surface.py CHANGE_SURFACE.md"
  },
  "devDependencies": {
    "nx": "^20.4.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
