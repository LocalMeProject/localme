{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "core-domain",
  "projectType": "library",
  "sourceRoot": "libs/core-domain/src",
  "tags": [
    "scope:backend",
    "profile:a",
    "lang:dotnet"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet format --verify-no-changes",
        "cwd": "libs/core-domain"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test ../../tests/LocalMe.Core.Tests/LocalMe.Core.Tests.csproj",
        "cwd": "libs/core-domain"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build src/LocalMe.Core.csproj -c Release",
        "cwd": "libs/core-domain"
      },
      "outputs": ["{projectRoot}/src/bin", "{projectRoot}/src/obj"]
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet list src/LocalMe.Core.csproj package --vulnerable --include-transitive || true",
        "cwd": "libs/core-domain"
      }
    }
  }
}
