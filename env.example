# LocalMe — environment template
# Copy to .env.local for development; set the same keys in your host's
# environment settings for production.

# Postgres connection string (Neon free tier works; any Postgres 14+).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# HMAC secret for session integrity. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Public origin of this deployment (canonical URLs, OG tags, hosted-project
# links, sitemap). Only needed outside local dev.
NEXT_PUBLIC_SITE_URL=""
